# Copy this file to .env and fill in the values.
# Firebase SDK keys are public by design (client-side usage is safe).

# === Cloudinary ===
REACT_APP_CLOUDINARY_CLOUD_NAME=
REACT_APP_CLOUDINARY_UPLOAD_PRESET=
REACT_APP_CLOUDINARY_API_KEY=
REACT_APP_CLOUDINARY_API_SECRET=    # Keep this private — only use server-side

# === Firebase (safe for client-side SDK) ===
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=

# === Private — backend/API only (never expose to client) ===
SHEET_WEBHOOK_URL=
EMAIL_USER=
EMAIL_PASS=
