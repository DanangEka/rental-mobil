# Copy this file to .env and fill in the values.
# Firebase SDK keys are public by design (client-side usage is safe).

# === Cloudinary ===
REACT_APP_CLOUDINARY_CLOUD_NAME=
REACT_APP_CLOUDINARY_UPLOAD_PRESET=
REACT_APP_CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=    # Backend only — no REACT_APP_ prefix, or it is inlined into the client bundle

# === Firebase (safe for client-side SDK) ===
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=

# === Google Calendar sync (optional) ===
# Falls back to the credentials already configured in src/services/googleCalendar.js.
# Only set these if you rotate the Google Cloud OAuth client / API key.
REACT_APP_GOOGLE_CLIENT_ID=
REACT_APP_GOOGLE_API_KEY=
# "primary" (default) = each signed-in admin's own calendar.
REACT_APP_GOOGLE_CALENDAR_ID=

# === Private — backend/API only (never expose to client) ===
SHEET_WEBHOOK_URL=
EMAIL_USER=
EMAIL_PASS=
