rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================
    // HELPER FUNCTIONS
    // =====================================================

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && userDoc().data.role == "admin"
        )
      );
    }

    function isDriver() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().data.role == "driver";
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // =====================================================
    // USERS
    // =====================================================

    match /users/{userId} {
      // User membaca datanya sendiri
      allow read: if isOwner(userId);

      // Driver & Admin membaca semua user
      allow read: if isDriver() || isAdmin();

      // Registrasi akun & admin pembuatan guest user
      allow create: if signedIn() && (
        (request.auth.uid == userId && request.resource.data.role in ["client", "driver"]) ||
        isAdmin()
      );

      // User update profil sendiri
      allow update: if isOwner(userId)
        && request.resource.data.role == resource.data.role
        && !request.resource.data.values().hasAny([null]);

      // Admin bebas
      allow write: if isAdmin();
    }

    // =====================================================
    // PEMESANAN
    // =====================================================

    match /pemesanan/{docId} {

      // -------------------------
      // READ
      // -------------------------

      allow read: if signedIn() && (
        resource.data.uid == request.auth.uid ||
        isDriver() ||
        isAdmin()
      );

      // -------------------------
      // CREATE
      // Client membuat pesanan miliknya sendiri, Admin membuat pesanan manual
      // -------------------------

      allow create: if signedIn() && (
        request.resource.data.uid == request.auth.uid ||
        isAdmin()
      );

      // -------------------------
      // DELETE
      // -------------------------

      allow delete: if isAdmin();

      // -------------------------
      // ADMIN
      // -------------------------

      allow update: if isAdmin();

      // -------------------------
      // CLIENT
      // Upload bukti pembayaran
      // -------------------------

      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).changedKeys()
          .hasOnly([
            "paymentMethod",
            "paymentProof",
            "paymentStatus",
            "waktuUpload",
            "dpAmount"
          ]);

      // -------------------------
      // DRIVER
      // -------------------------

      allow update: if isDriver()
        && (
          // Driver menerima order yang belum memiliki driver
          (
            (
              !("driverId" in resource.data) ||
              resource.data.driverId == null
            )
            && 
            request.resource.data.driverId == request.auth.uid
          )
          ||
          // Driver yang sudah menerima order
          (
            resource.data.driverId == request.auth.uid
            && request.resource.data.driverId == request.auth.uid
          )
        )
        && request.resource.data.diff(resource.data).changedKeys()
          .hasOnly([
            "driverId",
            "status",
            "assignedAt",
            "updatedAt",
            "actualPaymentAmount",
            "paymentVerifiedAt"
          ]);
    }

    // =====================================================
    // MOBIL & SUBCOLLECTION BOOKINGS (Publik Browsing)
    // =====================================================

    match /mobil/{mobilId} {
      // Siapa saja (termasuk tanpa login) dapat melihat katalog mobil
      allow read: if true;

      // Admin bebas
      allow create, delete: if isAdmin();

      allow update: if
        // Admin bebas
        isAdmin()
        ||
        // Client/user memperbarui status saat pemesanan
        signedIn()
        ||
        // Driver hanya boleh update status mobil
        (
          isDriver()
          && request.resource.data.diff(resource.data).changedKeys()
              .hasOnly([
                "status",
                "tersedia",
                "updatedAt"
              ])
        );

      // Subcollection bookings di bawah mobil
      match /bookings/{bookingId} {
        allow read: if true;
        allow create: if signedIn();
        allow update, delete: if isAdmin();
      }
    }

    match /units/{unitId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      match /bookings/{bookingId} {
        allow read: if true;
        allow create: if signedIn();
        allow update, delete: if isAdmin();
      }
    }

    // =====================================================
    // PAKET WISATA & TOUR PACKAGES (Publik Browsing)
    // =====================================================

    match /paket_wisata/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /tour_packages/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // =====================================================
    // OPEN TRIP (Publik Browsing)
    // =====================================================

    match /open_trips/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // =====================================================
    // COMPANY PROFILE (Publik Browsing)
    // =====================================================

    match /company_profile/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // =====================================================
    // NOTIFICATIONS
    // =====================================================

    match /notifications/{notifId} {
      // User membaca notif miliknya
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );

      // Semua user login boleh membuat notifikasi
      allow create: if signedIn();

      // User mengubah notif miliknya
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid;

      // Admin bebas
      allow update, delete: if isAdmin();
    }

    // =====================================================
    // DRIVER VERIFICATION
    // =====================================================

    match /vehicleVerifications/{docId} {
      // Driver membuat verifikasi miliknya sendiri
      allow create: if signedIn() && (
        request.resource.data.driverId == request.auth.uid ||
        isAdmin()
      );

      // Driver melihat verifikasi miliknya
      allow read: if signedIn() && (
        resource.data.driverId == request.auth.uid ||
        isAdmin()
      );

      // Driver mengubah verifikasi miliknya
      allow update: if signedIn()
        && resource.data.driverId == request.auth.uid
        && request.resource.data.driverId == request.auth.uid;

      // Admin bebas
      allow update, delete: if isAdmin();
    }

    // =====================================================
    // PAYMENT VERIFICATION
    // =====================================================

    match /paymentVerifications/{docId} {
      // Client / Driver membuat data
      allow create: if signedIn()
        && (
          request.resource.data.userId == request.auth.uid ||
          request.resource.data.driverId == request.auth.uid ||
          isAdmin()
        );

      // Melihat data
      allow read: if signedIn()
        && (
          resource.data.userId == request.auth.uid ||
          resource.data.driverId == request.auth.uid ||
          isAdmin()
        );

      // Update
      allow update: if signedIn()
        && (
          resource.data.userId == request.auth.uid ||
          resource.data.driverId == request.auth.uid
        );

      // Admin bebas
      allow update, delete: if isAdmin();
    }

    // =====================================================
    // DRIVER ASSIGNMENTS
    // =====================================================

    match /driver_assignments/{docId} {
      // Create
      allow create: if signedIn()
        && (
          request.resource.data.driverId == request.auth.uid ||
          isAdmin()
        );

      // Read
      allow read: if signedIn()
        && (
          resource.data.driverId == request.auth.uid ||
          isAdmin()
        );

      // Update
      allow update: if signedIn()
        && resource.data.driverId == request.auth.uid
        && request.resource.data.driverId == request.auth.uid;

      // Delete
      allow delete: if isAdmin();
    }

    // =====================================================
    // TRIP REQUESTS (Open Trip / Private Trip pengajuan client)
    // =====================================================

    match /trip_requests/{requestId} {
      // Client membaca request miliknya sendiri; admin melihat semua
      allow read: if signedIn() && (
        resource.data.uid == request.auth.uid ||
        isAdmin()
      );

      // Client membuat request baru
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == "submitted"
        && request.resource.data.dp_paid == false
        && request.resource.data.full_paid == false;

      // Admin bisa update semua field (status, quote, dll)
      allow update: if isAdmin();

      // Client bisa update: merespons quote (status, dp_paid) atau menambah catatan
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).changedKeys()
            .hasOnly(["status", "dp_paid", "dp_paid_at", "full_paid", "full_paid_at"]);

      // Hanya admin yang bisa hapus
      allow delete: if isAdmin();

      // Subcollection revisions: immutable setelah dibuat
      match /revisions/{revisionId} {
        // Client membaca revisi milik requestnya; admin melihat semua
        allow read: if signedIn() && (
          get(/databases/$(database)/documents/trip_requests/$(requestId)).data.uid == request.auth.uid ||
          isAdmin()
        );

        // Client & admin boleh membuat revisi
        allow create: if signedIn() && (
          get(/databases/$(database)/documents/trip_requests/$(requestId)).data.uid == request.auth.uid ||
          isAdmin()
        );

        // Revisi bersifat immutable — tidak ada update atau delete
        allow update, delete: if false;
      }
    }
  }
}